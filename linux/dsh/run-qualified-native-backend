#!/usr/bin/env bash
set -euo pipefail
LLM_ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$LLM_ROOT/hardware/rocm-env.sh"
export ROCR_VISIBLE_DEVICES=1,0 HIP_VISIBLE_DEVICES=0,1
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$LLM_ROOT/llm-tools/cuda-build/lib"
while IFS= read -r name; do
    case "$name" in MAYA_*|STRATA_*|DS4_*) unset "$name" ;; esac
done < <(compgen -e)
exec "$LLM_ROOT/strata/.venv/bin/python" -B "$LLM_ROOT/dsh/qualified_native_backend.py" --engine strata --host 127.0.0.1 "$@"
