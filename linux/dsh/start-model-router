#!/usr/bin/env bash
# Open the existing all-model frontend; inference starts on a chat request.
set -uo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
mkdir -p "$ROOT/dsh/logs"
log="$ROOT/dsh/logs/model-router-launcher.log"
{
    systemctl --user start local-llm-hub.service && "$ROOT/dsh/start-dsh" "$@"
} 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
if (( status != 0 )) && [[ -t 0 ]]; then
    printf '\nModel Router exited with code %s. Log: %s\nPress Enter to close.\n' "$status" "$log"
    read -r _ || true
fi
exit "$status"
