#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/hardware/rocm-env.sh"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$ROOT/llm-tools/cuda-build/lib"
export XDG_CONFIG_HOME="$ROOT/strata/local-config"
cd "$ROOT/strata"
exec .venv/bin/python serve/server.py --engine strata --config "$ROOT/dsh/strata-iq3-profile.json" --host 127.0.0.1 --port 30020 "$@"
