[Desktop Entry]
Type=Application
NoDisplay=true
Name=Model Router
Comment=Choose any local model in DSH; its backend starts on your first message
Exec=/usr/bin/ptyxis --new-window --title="Model Router" --working-directory=/opt/local-llm/dsh/workspace -- /opt/local-llm/dsh/start-model-router
Path=/opt/local-llm/dsh/workspace
Terminal=false
Icon=view-grid-symbolic
Categories=Development;
