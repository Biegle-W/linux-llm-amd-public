[Unit]
Description=Start graphical login when display and USB keyboard/mouse are connected
ConditionPathExists=/etc/systemd/system/display-manager.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/local-llm-gui-on-connect
ExecStart=/usr/bin/python3 /usr/local/libexec/local-llm-gui-on-connect.py
TimeoutStartSec=60
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
