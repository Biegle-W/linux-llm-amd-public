[Unit]
Description=Verify local LLM model drives (sharedSATA1; streaming models on system drive) at user-manager startup
# Model drives mount through system fstab; verify them without desktop login.
After=basic.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /opt/local-llm/dsh/shared_storage.py --all --wait 120
TimeoutStartSec=300
NoNewPrivileges=true

[Install]
WantedBy=default.target
