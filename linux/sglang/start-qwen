#!/usr/bin/env bash
set -euo pipefail
export CUDA_DEVICE_ORDER=PCI_BUS_ID
export CUDA_VISIBLE_DEVICES=0,1
export FLASHINFER_USE_CUDA_NORM=1
export SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=0
export PYTORCH_ALLOC_CONF=expandable_segments:True
export SGLANG_LOCAL_DISABLE_MULTIMEM_AG=1
exec /opt/local-llm/sglang/run \
 --model-path /opt/local-llm/models/Qwen3.8-27B-INT4-MTP-LowLatency \
 --served-model-name qwen3.8-27b-sglang \
 --host 127.0.0.1 --port 30000 --tp-size 2 \
 --disable-custom-all-reduce --language-only --json-model-override-args '{"language_model_only":true}' \
 --context-length 40960 --max-running-requests 1 \
 --mem-fraction-static 0.98 --max-total-tokens 40960 --max-mamba-cache-size 4 \
 --mamba-ssm-dtype bfloat16 --mamba-radix-cache-strategy extra_buffer_lazy \
 --kv-cache-dtype fp8_e5m2 --attention-backend triton \
 --chunked-prefill-size 512 --max-prefill-tokens 1024 \
 --cuda-graph-max-bs-decode 1 --cuda-graph-backend-prefill disabled \
 --reasoning-parser qwen3 --tool-call-parser qwen3_coder \
 --default-chat-template-kwargs '{"enable_thinking":false}' \
 --enable-metrics "$@"
