#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
source "$ROOT/hardware/rocm-env.sh"
if [[ ${1:-} == --check ]]; then
 exec "$ROOT/vllm/.venv-rocm/bin/python" "$ROOT/hardware/rocm-probe.py"
fi
export VLLM_LOCAL_SHARE_QWEN_MTP=1
export VLLM_USE_V2_MODEL_RUNNER=1
exec "$ROOT/vllm/.venv-rocm/bin/python" "$ROOT/vllm/rocm-bootstrap.py" "$@"
