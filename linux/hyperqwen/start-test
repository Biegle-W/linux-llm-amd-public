#!/usr/bin/env bash
set -euo pipefail
BASE=/opt/local-llm
python3 "$BASE/dsh/hardware_guard.py" hyperqwen
source "$BASE/vllm/env.sh"
export CUDA_VISIBLE_DEVICES=0,1
export VLLM_USE_V2_MODEL_RUNNER=1
export VLLM_LOCAL_DFLASH_META_SHARE=1
export MODEL=/opt/local-llm/models/HyperQwen/Qwen3.8-27B-AWQ-HyperQwen-fast
export HOST=127.0.0.1 PORT=${HYPERQWEN_PORT:-18020}
export CTX=long SPEC=${HYPERQWEN_SPEC:-mtp} DRAFT_TOKENS=3 MAX_SEQS=1 CG=4
export DRAFT=/opt/local-llm/models/HyperQwen/Qwen3.8-27B-DFlash2-W4A16
export DFLASH_TOKENS=7
if [ "$SPEC" = dflash2 ]; then
  export CG=8
  "$BASE/hyperqwen/upstream/venv/bin/python" - "$DRAFT" <<'PY'
import sys
from pathlib import Path
from safetensors import safe_open
files = list(Path(sys.argv[1]).glob('*.safetensors'))
assert files, 'Missing DFlash2 checkpoint'
for file in files:
    with safe_open(file, framework='pt', device='cpu') as f:
        assert not any('embed_tokens' in k or 'lm_head' in k for k in f.keys()), 'Drafter owns vocab weights; meta sharing is unsafe'
PY
fi
export MAX_LEN=${HYPERQWEN_CONTEXT:-65536}
export GPU_UTIL=0.82
if [ "$SPEC" = dflash2 ]; then
  export KV_MEM=${HYPERQWEN_KV_BYTES:-1073741824}
else
  export KV_MEM=${HYPERQWEN_KV_BYTES:-1610612736}
fi
export PREFIX_CACHE=${HYPERQWEN_PREFIX_CACHE:-1}
# Dense checkpoints evicted another document in this 1.25-GiB/rank pool.
# Preserve replay boundaries; an empty override selects upstream dense retention.
export PREFIX_RETENTION=${HYPERQWEN_PREFIX_RETENTION-0}
# Keep precision changes independently selectable for measured A/B comparisons.
export INT8_ACT=${HYPERQWEN_INT8_ACT-int8}
export INT8_LAYERS=${HYPERQWEN_INT8_LAYERS:-mlp}
export REQ_METRICS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
export EXTRA_ARGS="--tensor-parallel-size 2 --disable-custom-all-reduce --attention-backend TRITON_ATTN --kv-cache-dtype ${HYPERQWEN_KV_TYPE:-int4_per_token_head} --max-num-batched-tokens 512 --default-chat-template-kwargs {\"enable_thinking\":false} --served-model-name ${HYPERQWEN_SERVED_MODEL:-qwen3.8-27b} ${HYPERQWEN_EXTRA_ARGS:-}"
# vLLM 0.31 enables prefix caching by default: omitting the flag is not off.
# "legacy" reproduces the pre-optimization implicit policy for comparisons.
case "$PREFIX_CACHE" in
  0) export EXTRA_ARGS="$EXTRA_ARGS --no-enable-prefix-caching" ;;
  1|legacy) ;;
  *) echo 'HYPERQWEN_PREFIX_CACHE must be 0, 1 or legacy' >&2; exit 2 ;;
esac
exec bash "$BASE/hyperqwen/upstream/single-user/start_qwen.sh"
