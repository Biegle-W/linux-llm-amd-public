#!/usr/bin/env bash
set -euo pipefail
export CUDA_VISIBLE_DEVICES=0,1
export VLLM_LOCAL_SHARE_QWEN_MTP=1
export VLLM_USE_V2_MODEL_RUNNER=1
exec /opt/local-llm/vllm/run serve /mnt/llm-models/Qwen3.8-27B-INT4-MTP-LowLatency \
 --host 127.0.0.1 --port 30011 --served-model-name qwen3.8-27b-vllm \
 --tensor-parallel-size 2 --disable-custom-all-reduce --language-model-only \
 --max-model-len 49152 --max-num-seqs 1 --max-num-batched-tokens 512 \
 --gpu-memory-utilization 0.80 --kv-cache-memory-bytes 805306368 --kv-cache-dtype int4_per_token_head --attention-backend TRITON_ATTN \
 --mamba-cache-dtype bfloat16 --mamba-ssm-cache-dtype bfloat16 \
 --cudagraph-capture-sizes 1 4 --enable-auto-tool-choice --tool-call-parser qwen3_coder --reasoning-parser qwen3 \
 --default-chat-template-kwargs '{"enable_thinking":false}' "$@"
